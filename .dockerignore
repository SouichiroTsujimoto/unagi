# Keep the build context small: the image only needs Go sources, embedded
# assets (static/, articles/), and the migrations embedded by supabase/embed.go.
.git
.jj
.github
.cursor
bin
tmp
data
tools
node_modules
deploy
supabase/*
!supabase/embed.go
!supabase/migrations/
!supabase/migrations/*.sql
.env
.env.*
*.db
*.db-*
.DS_Store
