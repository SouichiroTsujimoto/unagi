{
  "BaseVolumeSz": "500m",
  "Args": [
    "-addr=:8080",
    "-db=/data/unagi.db"
  ],
  "Env": {
    "HOME": "/tmp",
    "TMPDIR": "/tmp",
    "UNIGO_CERTMAGIC_STORAGE": "/data/certmagic",
    "UNIGO_MEDIA_BACKEND": "local",
    "UNIGO_MEDIA_DIR": "/data/media",
    "UNIGO_WEBAUTHN_RPID": "localhost",
    "UNIGO_WEBAUTHN_ORIGINS": "http://localhost:8080",
    "UNIGO_SECURE_COOKIES": "false"
  },
  "Dirs": ["data"],
  "RunConfig": {
    "Ports": ["8080"]
  },
  "Mounts": {
    "unagi-data": "/data"
  }
}
