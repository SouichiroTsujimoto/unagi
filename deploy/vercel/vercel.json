{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "${CLOUD_RUN_ORIGIN}/$1",
      "env": ["CLOUD_RUN_ORIGIN"]
    }
  ]
}
