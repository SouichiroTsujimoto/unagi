# Copy to deploy/cloudrun/.env (gitignored). Read by every deploy/cloudrun script.

GCP_PROJECT=your-gcp-project
GCP_REGION=asia-northeast1
ARTIFACT_REPO=unagi
CLOUD_RUN_SERVICE=unagi

# owner/name. Required by bootstrap.sh to wire GitHub Actions (WIF).
GITHUB_REPO=SouichiroTsujimoto/unagi

# Site (non-secret). Must match Supabase Auth's Site URL / redirect URLs.
UNIGO_SITE_BASE_URL=https://example.com
UNIGO_SITE_NAME=unagi
UNIGO_SITE_DESCRIPTION=personal tech notes
UNIGO_MEDIA_PUBLIC_BASE=https://YOUR_REF.supabase.co/storage/v1/object/public/images

# Secret values. just cloudrun-secret copies these into Secret Manager.
# Quote values that contain spaces or shell metacharacters.
# UNIGO_DB_DSN: pooler session mode (port 5432). Direct db.<ref> is IPv6-only;
# transaction mode (6543) breaks prepared statements.
# Publishable / secret: Dashboard Settings > API Keys (`sb_publishable_...` / `sb_secret_...`).
# Do not use Legacy anon / service_role.
UNIGO_DB_DSN='postgresql://postgres.YOUR_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres'
UNIGO_SUPABASE_URL=https://YOUR_REF.supabase.co
UNIGO_SUPABASE_PUBLISHABLE_KEY=
UNIGO_SUPABASE_SECRET_KEY=
UNIGO_ADMIN_USER_IDS=

# Optional overrides. Defaults are shown; bootstrap.sh creates them.
# RUNTIME_SA=unagi-run
# DEPLOYER_SA=unagi-deployer
# IMAGE_TAG=                     # build tag, default: git describe
# UNIGO_DB_DSN_SECRET=unagi-db-dsn
# UNIGO_SUPABASE_URL_SECRET=unagi-supabase-url
# UNIGO_SUPABASE_PUBLISHABLE_KEY_SECRET=unagi-supabase-publishable
# UNIGO_SUPABASE_SECRET_KEY_SECRET=unagi-supabase-secret
# UNIGO_ADMIN_USER_IDS_SECRET=unagi-admin-ids
