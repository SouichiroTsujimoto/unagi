package about

import "github.com/SouichiroTsujimoto/unagi/internal/web/layout"

templ Page(meta layout.PageMeta, site layout.Site) {
	@layout.Document(meta) {
		<main class="flex flex-col gap-10">
			<header class="space-y-4">
				<img
					src="/static/wuhu1sland-2.png"
					alt={ site.Name }
					width="320"
					height="320"
					class="h-40 w-40 rounded-2xl object-cover"
					decoding="async"
				/>
				<div class="space-y-3">
					<h1 class="text-xl font-semibold tracking-tight">About</h1>
					if site.Author != "" {
						<p class="text-base-content/55 text-[15px] leading-relaxed">
							<span class="text-base-content font-medium">{ site.Author }</span>
							の個人技術ブログ
							<span class="text-base-content font-medium">{ site.Name }</span>
							です。
						</p>
					}
					if site.Description != "" {
						<p class="text-base-content/55 text-[15px] leading-relaxed">{ site.Description }</p>
					} else if site.Author == "" {
						<p class="text-base-content/55 text-[15px] leading-relaxed">
							<span class="text-base-content font-medium">{ site.Name }</span>
							は、個人用のミニマルな技術ブログです。
						</p>
					}
				</div>
			</header>

			<section class="space-y-4" aria-labelledby="writing-title">
				<h2 id="writing-title" class="text-base font-semibold tracking-tight">書き方</h2>
				<p class="text-base-content/55 text-[15px] leading-relaxed">
					記事はZenn互換のMarkdownとして
					<code class="text-base-content/70">articles/</code>
					に置き、画像は
					<code class="text-base-content/70">images/</code>
					へ配置します。公開設定はfrontmatterの
					<code class="text-base-content/70">published</code>
					と
					<code class="text-base-content/70">published_at</code>
					で制御します。
				</p>
			</section>

			<section class="space-y-4" aria-labelledby="subscribe-title">
				<h2 id="subscribe-title" class="text-base font-semibold tracking-tight">購読</h2>
				<p class="text-base-content/55 text-[15px] leading-relaxed">
					<a href="/feed.xml" class="link link-hover text-base-content">RSS</a>
					から新着記事を購読できます。
				</p>
			</section>
		</main>
	}
}
