package home

import (
	"github.com/SouichiroTsujimoto/unagi/internal/feature/article"
	"github.com/SouichiroTsujimoto/unagi/internal/web/layout"
)

templ Page(meta layout.PageMeta, site layout.Site, articles []article.Article) {
	@layout.Document(meta) {
		<main class="flex flex-col gap-12">
			<header class="space-y-4">
				<div class="flex items-center gap-3">
					<img
						src="/static/wuhu1sland-1.png"
						alt=""
						width="64"
						height="64"
						class="h-12 w-12 rounded-xl object-cover"
						decoding="async"
					/>
					<div class="space-y-1">
						<h1 class="text-xl tracking-tight">
							Hello from
							<a
								href="/about"
								class="link link-hover text-base-content"
								rel="noopener noreferrer"
							>wuhu1sland</a>
						</h1>
						if site.Description != "" {
							<p class="text-base-content/55 text-[15px] leading-relaxed">{ site.Description }</p>
						}
					</div>
				</div>
			</header>

			<section class="space-y-6" aria-labelledby="posts-title">
				<h2 id="posts-title" class="text-base font-semibold tracking-tight">Posts</h2>
				if len(articles) == 0 {
					<p class="text-base-content/55 text-[15px] leading-relaxed">まだ公開記事がありません。</p>
				} else {
					<ul class="flex flex-col gap-14">
						for _, post := range articles {
							<li>
								<article class="article-post article-braille-host group/post">
									<div class="flex items-start gap-3">
										<a
											href={ templ.SafeURL(post.Path()) }
											class="article-post-link article-post-icon-link shrink-0 focus-visible:outline-none"
											aria-hidden="true"
											tabindex="-1"
										>
											@articleBrailleIcon(post.Slug)
										</a>
										<div class="min-w-0 space-y-2">
											<a
												href={ templ.SafeURL(post.Path()) }
												class="article-post-link block space-y-2 focus-visible:outline-none"
											>
												<h3 class="text-[15px] font-medium leading-none tracking-tight group-hover/post:underline group-focus-visible/post:underline">
													if post.Emoji != "" {
														<span aria-hidden="true">{ post.Emoji }</span>
														<span> </span>
													}
													{ post.Title }
												</h3>
												if !post.PublishedAt.IsZero() {
													<time class="text-base-content/45 text-sm" datetime={ post.PublishedAt.Format("2006-01-02T15:04:05-07:00") }>
														{ post.PublishedAt.Format("2006-01-02") }
													</time>
												}
												if post.Summary != "" {
													<p class="text-base-content/55 line-clamp-2 text-[15px] leading-relaxed">{ post.Summary }</p>
												}
											</a>
											if len(post.Topics) > 0 {
												<ul class="flex flex-wrap gap-2">
													for _, topic := range post.Topics {
														<li>
															<a href={ templ.SafeURL(article.TopicPath(topic)) } class="badge badge-ghost badge-sm">{ topic }</a>
														</li>
													}
												</ul>
											}
										</div>
									</div>
								</article>
							</li>
						}
					</ul>
				}
			</section>
		</main>
	}
}
