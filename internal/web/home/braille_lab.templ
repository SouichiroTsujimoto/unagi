package home

// Braille icon lab (実験). Cascade / Swap / WAAPI + grid sizes + symbols.
// Static ASCII thumb / colored ANSI ロゴ実験は撤去済み。

templ brailleLab() {
	<section class="space-y-8 rounded-2xl border border-base-content/10 bg-base-200/40 p-5" aria-labelledby="braille-lab-title">
		<header class="space-y-1">
			<h2 id="braille-lab-title" class="text-base font-semibold tracking-tight">Braille icon lab (実験)</h2>
			<p class="text-base-content/55 text-[15px] leading-relaxed">Cascade / Swap / WAAPI を軸に、グリッドサイズと記号表現を試しています。ホバーかフォーカスで動かしてください。</p>
		</header>

		<div class="space-y-3">
			<h3 class="text-sm font-medium tracking-tight">Favorites · 2×4 Braille</h3>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				@brailleLabCard("Cascade", "CSS。ドットをtransition-delayで順点灯") {
					<div class="flex flex-wrap items-end gap-4">
						for _, seed := range labSeeds {
							@brailleCascade(seed)
						}
					</div>
				}
				@brailleLabCard("Swap", "CSS。表裏2グリフを入れ替え") {
					<div class="flex flex-wrap items-end gap-4">
						for _, seed := range labSeeds {
							@brailleSwap(seed)
						}
					</div>
				}
			@brailleLabCard("WAAPI", "island。フレーム列をワンショット再生") {
				<is-land on:visible>
					<template data-island>
						<div class="flex flex-wrap items-end gap-4">
							for _, seed := range labSeeds {
								@brailleWaapi(seed)
							}
						</div>
					</template>
				</is-land>
			}
			</div>
		</div>

		<div class="space-y-3">
			<h3 class="text-sm font-medium tracking-tight">Grid sizes · Cascade noise</h3>
			<p class="text-base-content/45 text-xs leading-relaxed">同じseedのノイズを 2×4 / 3×3 / 5×5 / 10×10 で比較。ホバーでcascade。</p>
			<div class="flex flex-wrap items-end gap-6 rounded-xl border border-base-content/10 bg-base-100 p-4">
				for _, size := range labSizes {
					@dotCascadeLabeled(NoiseGrid("hello-unagi", size.Cols, size.Rows), size.Label)
				}
			</div>
		</div>

		<div class="space-y-3">
			<h3 class="text-sm font-medium tracking-tight">Symbols · Cascade (5×5 / 10×10)</h3>
			<p class="text-base-content/45 text-xs leading-relaxed">矢印・顔・ハートなど。テンプレをnearest-neighborで拡大。</p>
			<div class="grid gap-4 sm:grid-cols-2">
				@brailleLabCard("5×5", "読みやすいサイズ") {
					<div class="flex flex-wrap items-end gap-4">
						for _, g := range labGlyphs {
							@dotCascadeLabeled(GlyphGrid(g.Name, 5, 5), g.Label)
						}
					</div>
				}
				@brailleLabCard("10×10", "密度を上げた版") {
					<div class="flex flex-wrap items-end gap-4">
						for _, g := range labGlyphs {
							@dotCascadeLabeled(GlyphGrid(g.Name, 10, 10), g.Label)
						}
					</div>
				}
			</div>
		</div>

		<div class="space-y-3">
			<h3 class="text-sm font-medium tracking-tight">Symbols · Swap</h3>
			<p class="text-base-content/45 text-xs leading-relaxed">関連する2状態を入れ替え(smile↔wink、arrow→↔←、heart↔complement)。</p>
			<div class="flex flex-wrap items-end gap-6 rounded-xl border border-base-content/10 bg-base-100 p-4">
				@dotSwapLabeled(GlyphGrid("smile", 5, 5), GlyphGrid("wink", 5, 5), "☺↔😉")
				@dotSwapLabeled(GlyphGrid("arrow-right", 5, 5), GlyphGrid("arrow-left", 5, 5), "→↔←")
				@dotSwapLabeled(GlyphGrid("arrow-up", 5, 5), GlyphGrid("arrow-down", 5, 5), "↑↔↓")
				@dotSwapLabeled(GlyphGrid("heart", 5, 5), Complement(GlyphGrid("heart", 5, 5)), "♥↔")
				@dotSwapLabeled(GlyphGrid("smile", 10, 10), GlyphGrid("wink", 10, 10), "10×10")
			</div>
		</div>

		<div class="space-y-3">
			<h3 class="text-sm font-medium tracking-tight">Noise · WAAPI</h3>
			<p class="text-base-content/45 text-xs leading-relaxed">ランダム寄りノイズがホバーでフレーム送り。3×3 / 5×5 / 10×10。</p>
			<is-land on:visible>
				<template data-island>
					<div class="flex flex-wrap items-end gap-6 rounded-xl border border-base-content/10 bg-base-100 p-4">
						@dotWaapiLabeled(NoiseFrames("hello-unagi", 3, 3, 8), 3, 3, "3×3")
						@dotWaapiLabeled(NoiseFrames("cascade-wave", 5, 5, 10), 5, 5, "5×5")
						@dotWaapiLabeled(NoiseFrames("spore-garden", 10, 10, 12), 10, 10, "10×10")
						@dotWaapiLabeled(glyphPulseFrames("arrow-right", 5, 5, 8), 5, 5, "→ pulse")
						@dotWaapiLabeled(glyphPulseFrames("smile", 5, 5, 8), 5, 5, "☺ pulse")
					</div>
				</template>
			</is-land>
		</div>

	</section>
}

templ brailleLabCard(title string, blurb string) {
	<article class="space-y-3 rounded-xl border border-base-content/10 bg-base-100 p-4">
		<div class="space-y-1">
			<h3 class="text-sm font-medium tracking-tight">{ title }</h3>
			<p class="text-base-content/45 text-xs leading-relaxed">{ blurb }</p>
		</div>
		{ children... }
	</article>
}

templ brailleCascade(seed string) {
	<span class="braille-cascade group/bc inline-flex flex-col items-center gap-1" title={ seed } tabindex="0">
		<span class="braille-cascade-grid" aria-hidden="true">
			for _, bit := range []int{0, 3, 1, 4, 2, 5, 6, 7} {
				<span
					class={ brailleDotClass(DotOn(seed, bit)) }
					style={ "--i:" + itoa(bit) }
				></span>
			}
		</span>
		<span class="text-base-content/35 max-w-[5.5rem] truncate font-mono text-[10px]">{ seed }</span>
	</span>
}

templ brailleSwap(seed string) {
	<span class="braille-swap group/bs inline-flex flex-col items-center gap-1" title={ seed } tabindex="0">
		<span class="braille-swap-face font-mono text-2xl leading-none" aria-hidden="true">
			<span class="braille-swap-a">{ swapRest(seed) }</span>
			<span class="braille-swap-b">{ swapHover(seed) }</span>
		</span>
		<span class="text-base-content/35 max-w-[5.5rem] truncate font-mono text-[10px]">{ seed }</span>
	</span>
}

templ brailleWaapi(seed string) {
	<braille-waapi frames={ FramesAttr(seed) } seed={ seed }></braille-waapi>
}

templ dotCascadeLabeled(g DotGrid, label string) {
	<span
		class={ "dot-cascade inline-flex flex-col items-center gap-1 size-" + sizeKey(g.Cols, g.Rows) }
		style={ gridStyle(g.Cols, g.Rows) }
		title={ label }
		tabindex="0"
	>
		<span class="dot-grid-face" aria-hidden="true">
			for i, on := range g.On {
				<span class={ brailleDotClass(on) } style={ "--i:" + itoa(i) }></span>
			}
		</span>
		<span class="text-base-content/35 font-mono text-[10px]">{ label }</span>
	</span>
}

templ dotSwapLabeled(rest DotGrid, hover DotGrid, label string) {
	<span
		class={ "dot-swap inline-flex flex-col items-center gap-1 size-" + sizeKey(rest.Cols, rest.Rows) }
		style={ gridStyle(rest.Cols, rest.Rows) }
		title={ label }
		tabindex="0"
	>
		<span class="dot-swap-face" aria-hidden="true">
			<span class="dot-swap-a dot-grid-face">
				for i, on := range rest.On {
					<span class={ brailleDotClass(on) } style={ "--i:" + itoa(i) }></span>
				}
			</span>
			<span class="dot-swap-b dot-grid-face">
				for i, on := range hover.On {
					<span class={ brailleDotClass(on) } style={ "--i:" + itoa(i) }></span>
				}
			</span>
		</span>
		<span class="text-base-content/35 font-mono text-[10px]">{ label }</span>
	</span>
}

templ dotWaapiLabeled(frames []DotGrid, cols int, rows int, label string) {
	<dot-grid-waapi
		cols={ itoa(cols) }
		rows={ itoa(rows) }
		frames={ FramesAttrFromGrids(frames) }
		label={ label }
	></dot-grid-waapi>
}
