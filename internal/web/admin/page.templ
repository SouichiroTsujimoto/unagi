package admin

import (
	"github.com/SouichiroTsujimoto/unagi/internal/feature/article"
	"github.com/SouichiroTsujimoto/unagi/internal/web/layout"
)

templ shell(site layout.Site, title string, active string, assets layout.Assets) {
	@layout.Document(layout.PageMeta{
		Title:       site.TitleWithSite(title),
		Description: "管理画面",
		Active:      active,
		Wide:        true,
		Assets:      assets,
	}) {
		{ children... }
	}
}

templ LoginPage(site layout.Site) {
	@shell(site, "Login", "admin", 0) {
		<main class="flex flex-col gap-8">
			<header class="space-y-2">
				<h1 class="text-xl font-semibold tracking-tight">Admin Login</h1>
				<p class="text-base-content/55 text-[15px] leading-relaxed">
					Xでログインします。管理者として許可されたアカウントだけが管理画面に入れます。
				</p>
			</header>
			@xSignIn("/auth/x/login?return_to=/admin")
		</main>
	}
}

templ ForbiddenPage(site layout.Site) {
	@shell(site, "Forbidden", "admin", 0) {
		<main class="flex flex-col gap-8">
			<header class="space-y-2">
				<h1 class="text-xl font-semibold tracking-tight">権限がありません</h1>
				<p class="text-base-content/55 text-[15px] leading-relaxed">
					このXアカウントは管理者として許可されていません。
				</p>
			</header>
			<div class="flex flex-wrap items-center gap-3">
				<a href="/" class="btn btn-ghost btn-sm">トップへ戻る</a>
				<a href="/auth/x/logout?return_to=/admin/login" class="btn btn-ghost btn-sm">別のアカウントでログイン</a>
			</div>
		</main>
	}
}

templ xSignIn(href string) {
	<a class="x-signin-btn" href={ templ.SafeURL(href) }>
		<svg class="x-signin-btn-logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
			<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
		</svg>
		<span class="x-signin-btn-label">Xでログイン</span>
	</a>
}

templ IndexPage(site layout.Site, items []article.Article) {
	@shell(site, "Articles", "admin", 0) {
		<main class="flex flex-col gap-8">
			<header class="flex flex-wrap items-end justify-between gap-4">
				<div class="space-y-1">
					<h1 class="text-xl font-semibold tracking-tight">記事管理</h1>
					<p class="text-base-content/55 text-[15px]">{ site.Name }</p>
					<p class="text-base-content/45 text-sm leading-relaxed">
						本文と画像はGitHubの記事リポジトリが正本です。ここでは公開切替と、コメント・ステッカーの管理だけを行います。
					</p>
				</div>
				<form method="post" action="/admin/logout">
					<button class="btn btn-ghost btn-sm" type="submit">Logout</button>
				</form>
			</header>
			if len(items) == 0 {
				<p class="text-base-content/55 text-[15px]">記事がありません。記事リポジトリを同期するとここに現れます。</p>
			} else {
				<ul class="divide-y divide-base-content/10">
					for _, item := range items {
						<li class="flex flex-wrap items-start justify-between gap-4 py-4 first:pt-0 last:pb-0">
							<div class="space-y-1">
								<a href={ templ.SafeURL("/admin/articles/" + itoa(item.ID)) } class="font-medium hover:underline">
									if item.Emoji != "" {
										{ item.Emoji + " " }
									}
									{ item.Title }
								</a>
								<p class="text-base-content/45 text-sm">
									{ item.Slug } · { statusLabel(item) }
									if !item.PublishedAt.IsZero() {
										{ " · 投稿日 " + item.PublishedAt.Format("2006-01-02 15:04") }
									}
								</p>
							</div>
							@publishToggle(item)
						</li>
					}
				</ul>
			}
		</main>
	}
}

templ ManagePage(site layout.Site, item article.Article, ogImageURL string) {
	@shell(site, item.Title, "admin", layout.AssetAdminEngagement) {
		<main class="flex flex-col gap-6">
			<header class="flex flex-wrap items-end justify-between gap-4">
				<div class="space-y-1">
					<p class="text-sm text-base-content/45"><a href="/admin" class="hover:underline">記事管理</a> / 管理</p>
					<h1 class="text-xl font-semibold tracking-tight">
						if item.Emoji != "" {
							{ item.Emoji + " " }
						}
						{ item.Title }
					</h1>
					<p class="text-base-content/45 text-sm">
						{ item.Slug } · { statusLabel(item) }
						if !item.PublishedAt.IsZero() {
							{ " · 投稿日 " + item.PublishedAt.Format("2006-01-02 15:04") }
						}
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-2">
					@publishToggle(item)
					<a href="/admin" class="btn btn-ghost btn-sm">戻る</a>
				</div>
			</header>
			<section class="space-y-5 border-t border-base-content/10 pt-8">
				<header class="flex flex-wrap items-end justify-between gap-4">
					<div class="space-y-1">
						<h2 class="text-base font-semibold tracking-tight">記事別OGP</h2>
						<p class="text-base-content/55 text-[15px] leading-relaxed">
							公開中の記事で使用されるOGP画像です。Brailleは1.5倍、off dotsは非表示で生成します。
						</p>
					</div>
					<form method="post" action={ templ.SafeURL("/admin/articles/" + itoa(item.ID) + "/regenerate-ogp") }>
						<button class="btn btn-ghost btn-sm" type="submit">OGPを再生成</button>
					</form>
				</header>
				<form
					method="post"
					action={ templ.SafeURL("/admin/articles/" + itoa(item.ID) + "/og-template") }
					class="flex flex-wrap items-center gap-2"
				>
					if item.OGTemplate == article.OGTemplateEditorial {
						<button class="btn btn-primary btn-sm" type="button" disabled>05 Editorial + Braille · 選択中</button>
						<button class="btn btn-ghost btn-sm" type="submit" name="template" value={ article.OGTemplateDotDark }>06 Dot Grid Darkに変更</button>
					} else {
						<button class="btn btn-ghost btn-sm" type="submit" name="template" value={ article.OGTemplateEditorial }>05 Editorial + Brailleに変更</button>
						<button class="btn btn-primary btn-sm" type="button" disabled>06 Dot Grid Dark · 選択中</button>
					}
				</form>
				if item.Published {
					<div class="space-y-2">
						<p class="text-sm font-medium">公開PNG · { ogTemplateLabel(item) } · v{ itoa(item.OGVersion) }</p>
						<a href={ templ.SafeURL(ogImageURL) } target="_blank" rel="noopener noreferrer" class="block">
							<img
								src={ ogImageURL }
								alt={ item.Title + "のOGP画像" }
								width="1200"
								height="630"
								class="aspect-[1200/630] w-full border border-base-content/10 object-cover"
							/>
						</a>
						<p class="text-base-content/45 break-all text-xs">{ ogImageURL }</p>
					</div>
				} else {
					<p class="text-base-content/45 text-sm">公開PNGは記事を公開すると取得できます。</p>
				}
			</section>
			<section class="space-y-3 border-t border-base-content/10 pt-8">
				<header class="space-y-1">
					<h2 class="text-base font-semibold tracking-tight">ステッカーボード</h2>
					<p class="text-base-content/55 text-[15px] leading-relaxed">
						貼られた順の一覧です。選択して剥がすか、すべて削除できます。
					</p>
				</header>
				<is-land on:visible import="/static/islands/admin-stickers.js">
					<template data-island>
						<admin-stickers article-id={ itoa(item.ID) }></admin-stickers>
					</template>
				</is-land>
			</section>
			<section class="space-y-3 border-t border-base-content/10 pt-8">
				<header class="space-y-1">
					<h2 class="text-base font-semibold tracking-tight">コメント</h2>
					<p class="text-base-content/55 text-[15px] leading-relaxed">
						非表示・再表示・削除ができます。非表示にしたコメントは公開ページに出ません。
					</p>
				</header>
				<is-land on:visible import="/static/islands/admin-comments.js">
					<template data-island>
						<admin-comments article-id={ itoa(item.ID) }></admin-comments>
					</template>
				</is-land>
			</section>
		</main>
	}
}

templ publishToggle(item article.Article) {
	if item.Published {
		<form method="post" action={ templ.SafeURL("/admin/articles/" + itoa(item.ID) + "/unpublish") }>
			<button class="btn btn-ghost btn-sm" type="submit">非公開にする</button>
		</form>
	} else {
		<form method="post" action={ templ.SafeURL("/admin/articles/" + itoa(item.ID) + "/publish") }>
			<button class="btn btn-primary btn-sm" type="submit">公開する</button>
		</form>
	}
}
