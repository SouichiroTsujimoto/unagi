package layout

import "github.com/SouichiroTsujimoto/unagi/internal/web/css"

// Document is the shared HTML shell for full-page routes.
templ Document(meta PageMeta) {
	<!DOCTYPE html>
	<html
		lang="ja"
		data-theme={ css.ThemeLight() }
		data-theme-light={ css.ThemeLight() }
		data-theme-dark={ css.ThemeDark() }
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ meta.Title }</title>
			if meta.Description != "" {
				<meta name="description" content={ meta.Description }/>
			}
			if meta.Canonical != "" {
				<link rel="canonical" href={ meta.Canonical }/>
			}
			<meta property="og:title" content={ meta.Title }/>
			if meta.Description != "" {
				<meta property="og:description" content={ meta.Description }/>
			}
			<meta property="og:type" content={ ogType(meta.OGType) }/>
			if meta.Canonical != "" {
				<meta property="og:url" content={ meta.Canonical }/>
			}
			if meta.OGImage != "" {
				<meta property="og:image" content={ meta.OGImage }/>
			}
			<meta name="twitter:card" content="summary"/>
			<meta name="twitter:title" content={ meta.Title }/>
			if meta.Description != "" {
				<meta name="twitter:description" content={ meta.Description }/>
			}
			<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed.xml"/>
			<link rel="icon" href="/static/wuhu1sland-1.png" type="image/png"/>
			<script src="/static/theme.js"></script>
			<link rel="stylesheet" href="/static/app.css"/>
			<script type="importmap">
				{
					"imports": {
						"preact": "/static/vendor/preact.module.js",
						"preact/hooks": "/static/vendor/preact-hooks.module.js",
						"htm": "/static/vendor/htm.module.js",
						"htm/preact": "/static/vendor/htm-preact.module.js",
						"preact-custom-element": "/static/vendor/preact-custom-element.esm.js"
					}
				}
			</script>
			<script type="module" src="/static/islands/boot.js"></script>
			if src := devReloadScriptURL(); src != "" {
				<script src={ src } defer></script>
			}
		</head>
		<body id="top" class="bg-base-100 text-base-content min-h-screen antialiased">
			<div class={ containerClass(meta.Wide) }>
				<div class="mb-10 flex items-center justify-between gap-4">
					<nav aria-label="メイン">
						<ul class="flex items-center gap-5">
							<li>
								<a href="/" class={ navClass(meta.Active, "home") }>記事</a>
							</li>
							<li>
								<a href="/about" class={ navClass(meta.Active, "about") }>About</a>
							</li>
						</ul>
					</nav>
					<label class="swap swap-rotate text-base-content/50 hover:text-base-content" aria-label="テーマを切り替え">
						<input type="checkbox" class="theme-controller" value={ css.ThemeDark() }/>
						<svg class="swap-off h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"></path>
						</svg>
						<svg class="swap-on h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"></path>
						</svg>
					</label>
				</div>
				{ children... }
			</div>
			@BackToTop()
		</body>
	</html>
}
