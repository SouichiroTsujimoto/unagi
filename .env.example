# Copy to .env for local development.
# `just run`(cmd/dev) loads .env. Already-set shell env wins over these values.
# Do not put secrets in .unigo.toml.

# Required only for first-time /admin/setup.
# Raw token is OK locally (server hashes it). Or set a sha256 hex digest.
# Generate:
#   TOKEN=$(openssl rand -hex 32)
#   echo "UNIGO_BOOTSTRAP_TOKEN_HASH=$TOKEN" >> .env
#   echo "setup token: $TOKEN"
UNIGO_BOOTSTRAP_TOKEN_HASH=

# Usually unnecessary when [site].base_url is http://localhost:8080 in .unigo.toml.
# UNIGO_WEBAUTHN_RPID=localhost
# UNIGO_WEBAUTHN_ORIGINS=http://localhost:8080
# UNIGO_SECURE_COOKIES=false
# UNIGO_MEDIA_BACKEND=local
# UNIGO_MEDIA_DIR=data/media
