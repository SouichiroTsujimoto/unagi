# Copy to .env for local development.
# `just run`(cmd/dev) loads .env. Already-set shell env wins over these values.
# Do not put secrets in .unigo.toml.
#
# Start local Supabase first: `supabase start` then fill keys from `supabase status`.
# Use Publishable / Secret (`sb_publishable_...` / `sb_secret_...`), not legacy anon / service_role.

# Postgres (local Supabase default).
UNIGO_DB_DSN=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth + Storage (local defaults from `supabase start`).
UNIGO_SUPABASE_URL=http://127.0.0.1:54321
UNIGO_SUPABASE_PUBLISHABLE_KEY=
UNIGO_SUPABASE_SECRET_KEY=
# JWT verification uses {UNIGO_SUPABASE_URL}/auth/v1/.well-known/jwks.json.

# Comma-separated Supabase Auth user UUIDs allowed into /admin.
# Create the user in Studio, then paste the UUID here.
UNIGO_ADMIN_USER_IDS=

# Public image base (no trailing slash). Local Storage public URL:
# UNIGO_MEDIA_PUBLIC_BASE=http://127.0.0.1:54321/storage/v1/object/public/images
UNIGO_MEDIA_PUBLIC_BASE=http://127.0.0.1:54321/storage/v1/object/public/images
# UNIGO_MEDIA_BUCKET=images

# Site metadata (overrides .unigo.toml).
# UNIGO_SITE_BASE_URL=http://localhost:8080
# UNIGO_SITE_NAME=unagi
# UNIGO_SITE_DESCRIPTION=personal tech notes
# UNIGO_SITE_AUTHOR=
# UNIGO_SECURE_COOKIES=false

# X (Twitter) OAuth is configured in Supabase Auth providers, not here.
# Callback registered in the X app / Supabase dashboard:
#   {UNIGO_SITE_BASE_URL}/auth/x/callback
# Or Supabase's own callback URL from the dashboard.
